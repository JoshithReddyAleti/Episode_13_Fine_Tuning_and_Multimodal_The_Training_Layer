{
  "dashboard": {
    "title": "Episode 13 - Training & Multi-LoRA Serving",
    "tags": [
      "ep13",
      "training",
      "multi-lora"
    ],
    "panels": [
      {
        "title": "Training loss over time",
        "type": "graph",
        "targets": [
          {
            "expr": "train_loss"
          }
        ]
      },
      {
        "title": "Learning rate",
        "type": "graph",
        "targets": [
          {
            "expr": "train_lr"
          }
        ]
      },
      {
        "title": "Tokens per second",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(train_tokens_total[5m])"
          }
        ]
      },
      {
        "title": "GPU memory usage",
        "type": "graph",
        "targets": [
          {
            "expr": "nvidia_gpu_memory_used_bytes"
          }
        ]
      },
      {
        "title": "Adapter cache hit rate",
        "type": "stat",
        "targets": [
          {
            "expr": "adapter_cache_hit_rate"
          }
        ]
      },
      {
        "title": "Multi-LoRA active adapters",
        "type": "stat",
        "targets": [
          {
            "expr": "vllm_num_lora_adapters_active"
          }
        ]
      },
      {
        "title": "Requests by adapter",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vllm_requests_total{adapter!=''}[5m]) by (adapter)"
          }
        ]
      },
      {
        "title": "E2E latency P50/P95/P99",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, vllm_e2e_latency_seconds)"
          }
        ]
      }
    ]
  }
}